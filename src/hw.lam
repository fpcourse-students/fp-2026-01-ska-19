-- Домашка 1. Лямбда-исчисление.
-- Решения пишутся на месте дырок `...`. Проверка: `make check`. Как пишутся термы и проверки — lambda-engine/README.md.
-- Интерпретатор: `make repl`; как им пользоваться — lambda-engine/TUTORIAL.md, разделы 1–5 и 8.
-- Уровни: 1.x — обязательные, 2.x — подготовка к очной сессии. Свободные переменные, которые встречаются в условиях, перечислены в `vars`.

language pure
vars a b x y z


-- ============================================================
-- Определения с лекции и практики 1. Менять их не нужно.
-- Числа Чёрча записываются цифрами: 3 — это ⌜3⌝ = \s z. s (s (s z)).
-- ============================================================

I  := \x. x
K  := \x y. x
K' := \x y. y            -- K* с лекции
S  := \x y z. x z (y z)
B  := \f g x. f (g x)
C  := \f x y. f y x

true  := \t e. t
false := \t e. e
if    := \b t e. b t e
not   := \b. if b false true
and   := \a b. if a b false

pair := \x y f. f x y
fst  := \p. p K
snd  := \p. p K'
swap := \p. pair (snd p) (fst p)

natElim := \n s z. n s z
suc     := \n s z. s (natElim n s z)
plus    := \n m. natElim n suc m
isEven  := \n. natElim n not true


-- ============================================================
-- Уровень 1. Обязательные задачи
-- ============================================================

task 1.1 (лишние скобки)
-- Запишите каждый терм без лишних скобок, не переименовывая связанных переменных.
-- Подсказка: терм — это дерево.

given_1_1a := (\x. (x (x)))
minimal given_1_1a = \x. x x

given_1_1b := (\x y. a ((b x) y))
minimal given_1_1b = \x y. a (b x y)

given_1_1c := a (\y. (\z. a y z))
minimal given_1_1c = a \y z. a y z


task 1.2 (свободные и связанные переменные)
-- Найдите все свободные переменные и обозначьте, к какому связывателю относится
-- каждая связанная: перепишите терм так, чтобы все связыватели назывались
-- по-разному (например, x1, x2), а свободные переменные остались как есть.
-- В (б) и (в) свободные переменные нарочно зовутся так же, как связанные.

given_1_2a := \x. \x. x a
free given_1_2a = a
rename given_1_2a = \x1. \x2. x2 a

given_1_2b := \z. (\x. x) (x z)
free given_1_2b = x
rename given_1_2b = \z. (\x1. x1) (x z)

given_1_2c := \x. y y (\y. x ((\z. z y x) (\x. z x)))
free given_1_2c = y z
rename given_1_2c = \x1. y y (\y1. x1 ((\z1. z1 y1 x1) (\x2. z x2)))


task 1.3 (предскажите нормальную форму)
-- Впишите справа нормальную форму терма слева, сначала в голове и только потом
-- сверяясь с интерпретатором (`:follow терм` покажет шаги). Имена связанных
-- переменных не важны: проверка сравнивает термы с точностью до α.

expect K I S = I
expect (\x y. x) y = (\x y. x) y
expect and (not false) true = true
expect natElim 2 suc 1 = 3


task 1.4 (β-эквивалентность комбинаторов)
-- Покажите, что K' =β K I. Один шаг на строку: ~b~> β-редукция, ~K~> раскрытие
-- (или сворачивание) одного вхождения имени K (как ⇝_K на практике),
-- =a= переименование связанной переменной. Строк может быть сколько угодно.

chain t1_4 from (K I) to K' =
  K I
  ~K~> (\t e. t) I
  ~b~> \e. I
  ~I~> \e. \x. x
  ~K'~> K'

task 1.5 (дизъюнкция)
-- Задайте терм or p q, вычисляющий дизъюнкцию двух логических значений.

or := \a b. if a true b
expect or true true = true
expect or true false = true
expect or false true = true
expect or false false = false


task 1.6 (проверка на ноль)
-- Задайте терм isZero: true на 0 и false на остальных числах Чёрча.

isZero := \n. n (true false) true
expect isZero 0 = true
expect isZero 1 = false
expect isZero 4 = false


task 1.7 (умножение и степень)
-- Задайте терм mult n m, перемножающий числа Чёрча, и терм pow n m, вычисляющий n^m.
-- В интерпретаторе pow 5 0 может выглядеть как \z. z: это ⌜1⌝ с точностью до
-- eta эквивалентности, и проверка такой ответ примет.

mult := \n m. m (plus n) 0
pow := \n m. m (mult n) 1
expect mult 2 3 = 6
expect mult 0 5 = 0
expect mult 3 1 = 3
expect pow 2 3 = 8
expect pow 3 2 = 9
expect pow 5 0 = 1


-- ============================================================
-- Уровень 2. Подготовка к очной сессии
-- ============================================================

task 2.1 (β-эквивалентность комбинаторов: B)
-- Покажите, что B =β S (K S) K, по одному шагу на строку, как в задаче 1.4.
-- Подсказка: не спешите раскрывать все определения.

chain t2_1 from (S (K S) K) to B =
  S (K S) K
  ~S~> (\x y z. x z (y z)) (K S) K
  ~b~> (\y z. (K S) z (y z)) K
  ~b~> \z. K S z (K z)
  ~K~> \z. (\x y. x) S z (K z)
  ~b~> \z. (\y. S) z (K z)
  ~b~> \z. S (K z)
  ~S~> \z. (\x y z2. x z2 (y z2)) (K z)
  ~b~> \z y z2. (K z) z2 (y z2)
  ~K~> \z y z2. (\x y. x) z z2 (y z2)
  ~b~> \z y z2. (\y. z) z2 (y z2)
  ~b~> \z y z2. z (y z2)
  ~B~> B


task 2.2 (подстановка и нормальная форма)
-- Осуществите подстановку [x |-> S] в терм x (\z x. z x) (\z y x. x) x (шаг ~s~>)
-- и приведите терм к нормальной форме, указывая основные шаги.
-- Стрелка ~~> объединяет до трёх шагов.

chain t2_2 from ([x |-> S] x (\z x. z x) (\z y x. x) x) =
  [x |-> S] x (\z x. z x) (\z y x. x) x
  ~s~> S (\z x. z x) (\z y x. x) S
  ~S~> (\x y z. x z (y z)) (\z x. z x) (\z y x. x) S
  ~~> (\z x. z x) S ((\z y x. x) S)
  ~~> S ((\z y x. x) S)
  ~~> (\x y z. x z (y z)) ((\z y x. x) S)
  ~~> \y z. ((\z y x. x) S) z (y z)
  ~~> \y z. (\x. x) (y z)
  ~~> \y z. y z



task 2.3 (подстановка двух имён)
-- Осуществите подстановку [x |-> K, y |-> B] в терм y (K (\z. x x (x z x)) y) (\x. x x x) I
-- и приведите терм к нормальной форме, как в задаче 2.2.

chain t2_3 from ([x |-> K, y |-> B] y (K (\z. x x (x z x)) y) (\x. x x x) I) =
  [x |-> K, y |-> B] y (K (\z. x x (x z x)) y) (\x. x x x) I
  ~s~> B (K (\z. K K (K z K)) B) (\x. x x x) I
  ~B~> (\f g x. f (g x)) (K (\z. K K (K z K)) B) (\x. x x x) I
  ~~> (K (\z. K K (K z K)) B) ((\x. x x x) I)
  ~~> (K (\z. K K (K z K)) B) (I I I)
  ~~> (\z. K K (K z K)) (I I I)
  ~~> (\z. K K (K z K)) (I I)
  ~~> (\z. K K (K z K)) I
  ~~> K K (K I K)
  ~~> K K ((\t e. t) I K)
  ~~> K K I
  ~~> (\t e. t) K I
  ~~> K
  ~K~> \t e. t


task 2.4 (делимость на три)
-- Задайте терм divides3 n: true, если n делится на 3 без остатка, иначе false.
-- Вспомогательные определения можно добавлять выше основного.

troika := \a b c. pair a (pair b c)
nextTroika := \t. troika (snd (snd t)) (fst t) (fst (snd t))
divides3 := \n. if fst (n nextTroika (troika true false false))
expect divides3 0 = true
expect divides3 1 = false
expect divides3 2 = false
expect divides3 3 = true
expect divides3 5 = false
expect divides3 6 = true
expect divides3 9 = true


task 2.5 (предыдущее число)
-- Задайте терм pred n, находящий предыдущее число Чёрча (pred 0 = 0).
-- Подсказка: пройдите от 0 до n, храня пару «предыдущее, текущее».

nextPair := \p. pair (suc (fst p)) (fst p)
pred := \n. snd (n nextPair (pair 0 0))
expect pred 0 = 0
expect pred 1 = 0
expect pred 2 = 1
expect pred 5 = 4
